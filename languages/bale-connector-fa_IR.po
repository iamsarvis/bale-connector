#: bale-connector.php
msgid "Bale Connector requires PHP %1$s+ (current: %2$s) and WordPress %3$s+ (current: %4$s). The plugin has been deactivated."
msgstr "افزونهٔ Bale Connector به PHP %1$s یا بالاتر (فعلی: %2$s) و وردپرس %3$s یا بالاتر (فعلی: %4$s) نیاز دارد. افزونه غیرفعال شد."

#: bale-connector.php
msgid "No Bale bot token is configured. Please set your token on the Settings page."
msgstr "هیچ توکن ربات بیل تنظیم نشده است. لطفاً توکن خود را در صفحهٔ تنظیمات وارد کنید."

#: bale-connector.php
msgid "Unable to decrypt the stored bot token. The encryption key may have changed or been corrupted."
msgstr "بازگشایی توکن ذخیره‌شدهٔ ربات ممکن نشد. ممکن است کلید رمزنگاری تغییر کرده یا خراب شده باشد."

#: bale-connector.php
msgid "Connected to bot @%1$s (id: %2$s, name: %3$s)"
msgstr "به ربات @%1$s متصل شد (شناسه: %2$s، نام: %3$s)"

#: includes/class-bale-cf7-admin-panel.php
msgid "Bale Notification"
msgstr "اعلان بیل"

msgid "Saving..."
msgstr "در حال ذخیره…"

msgid "Saved."
msgstr "ذخیره شد."

msgid "Sending test message..."
msgstr "در حال ارسال پیام آزمایشی…"

msgid "An unexpected error occurred. Please try again."
msgstr "خطای غیرمنتظره‌ای رخ داد. لطفاً دوباره تلاش کنید."

msgid "Template exceeds the 4096 character Bale limit."
msgstr "قالب از سقف ۴۰۹۶ نویسهٔ بیل فراتر رفته است."

#: includes/class-bale-cf7-admin-panel.php
msgctxt "bale-connector"
msgid ""
"New form submission\n"
"Form: [form-title]\n"
"Name: [your-name]\n"
"Message: [your-message]"
msgstr ""
"ارسال جدید از فرم\n"
"فرم: [form-title]\n"
"نام: [your-name]\n"
"پیام: [your-message]"

msgid "Permission denied."
msgstr "دسترسی مجاز نیست."

msgid "Sample subject"
msgstr "موضوع نمونه"

msgid "This is a preview message."
msgstr "این یک پیام پیش‌نمایش است."

msgid "Recipient not found."
msgstr "گیرنده یافت نشد."

msgid "[Bale Connector] Test message — your form settings work!"
msgstr "[Bale Connector] پیام آزمایشی — تنظیمات فرم شما کار می‌کند!"

msgid "Test message delivered to Bale."
msgstr "پیام آزمایشی به بیل ارسال شد."

msgid "No valid recipients configured for this form."
msgstr "هیچ گیرندهٔ معتبری برای این فرم پیکربندی نشده است."

#: includes/class-bale-logger.php
msgid "Trigger slug is required and cannot be empty."
msgstr "اسلاگ تریگر الزامی است و نمی‌تواند خالی باشد."

msgid "Trigger args are required and must be an array."
msgstr "آرگومان‌های تریگر الزامی است و باید آرایه باشد."

msgid "Trigger \"%s\" is already registered."
msgstr "تریگر «%s» از قبل ثبت شده است."

msgid "Log entry source_type is required."
msgstr "source_type برای ثبت لاگ الزامی است."

msgid "Unknown log source_type \"%s\". Register the trigger first via bale_connector_register_trigger()."
msgstr "source_type ناشناختهٔ «%s». ابتدا تریگر را از طریق bale_connector_register_trigger() ثبت کنید."

msgid "Log entry recipient_chat_id is required."
msgstr "recipient_chat_id برای ثبت لاگ الزامی است."

msgid "Failed to write to the Bale Connector logs table."
msgstr "نوشتن در جدول لاگ‌های Bale Connector ناموفق بود."

#: includes/class-bale-admin.php
msgid "Bale Connector was unable to decrypt your Bot Token (the encryption key may have changed or corrupted). Please <a href=\"%s\">re-enter your Bot Token</a>."
msgstr "Bale Connector نتوانست توکن ربات شما را بازگشایی کند (ممکن است کلید رمزنگاری تغییر کرده یا خراب شده باشد). لطفاً <a href=\"%s\">توکن ربات را دوباره وارد کنید</a>."

#: includes/class-bale-admin.php
msgid "Bale Connector"
msgstr "Bale Connector"

msgid "Settings"
msgstr "تنظیمات"

msgid "Recipients"
msgstr "گیرنده‌ها"

msgid "Logs"
msgstr "لاگ‌ها"

msgid "General Settings"
msgstr "تنظیمات عمومی"

msgid "Bot Token"
msgstr "توکن ربات"

msgid "Keep Data on Uninstall"
msgstr "حفظ داده‌ها هنگام حذف افزونه"

msgid "Log Level"
msgstr "سطح ثبت لاگ"

msgid "Log Storage Cap (MB)"
msgstr "سقف حجم لاگ (مگابایت)"

msgid "Invalid Bot Token format. It typically looks like: 123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ"
msgstr "قالب توکن ربات نامعتبر است. معمولاً به شکل 123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ است."

msgid "No supported cryptographic extension (libsodium or OpenSSL) is available on this server. The token cannot be securely stored."
msgstr "هیچ افزونهٔ رمزنگاری پشتیبانی‌شده‌ای (libsodium یا OpenSSL) روی این سرور موجود نیست. توکن نمی‌تواند به‌صورت امن ذخیره شود."

msgid "Failed to securely encrypt the Bot Token. Please check server permissions or logs."
msgstr "رمزنگاری امن توکن ربات ناموفق بود. لطفاً دسترسی‌های سرور یا لاگ‌ها را بررسی کنید."

msgid "Configure your Bale Bot API connection settings."
msgstr "تنظیمات اتصال به Bot API بیل را پیکربندی کنید."

msgid "Enter your bot token from @BotFather"
msgstr "توکن ربات خود را از @BotFather وارد کنید"

msgid "The token is encrypted securely before being stored in the database."
msgstr "توکن پیش از ذخیره در پایگاه‌داده به‌صورت امن رمزنگاری می‌شود."

msgid "Preserve recipients and logs if the plugin is uninstalled."
msgstr "با حذف افزونه، گیرنده‌ها و لاگ‌ها حفظ شوند."

msgid "Log all sends (success and failed)"
msgstr "ثبت همهٔ ارسال‌ها (موفق و ناموفق)"

msgid "Log failed sends only"
msgstr "فقط ثبت ارسال‌های ناموفق"

msgid "Choose which send attempts are stored in the logs table."
msgstr "انتخاب کنید کدام تلاش‌های ارسال در جدول لاگ ذخیره شوند."

msgid "MB"
msgstr "مگابایت"

msgid "Oldest logs are pruned automatically once storage exceeds this size. Set 0 to keep logs indefinitely."
msgstr "قدیمی‌ترین لاگ‌ها پس از عبور حجم از این سقف به‌طور خودکار حذف می‌شوند. برای نگهداری نامحدود، ۰ بگذارید."

msgid "You do not have sufficient permissions to access this page."
msgstr "دسترسی کافی برای مشاهدهٔ این صفحه را ندارید."

msgid "Log entry deleted."
msgstr "آیتم لاگ حذف شد."

msgid "%s log entries deleted."
msgstr "%s آیتم لاگ حذف شد."

msgid "Delete this log entry? This cannot be undone."
msgstr "این آیتم لاگ حذف شود؟ این عمل قابل بازگشت نیست."

msgid "Delete the selected log entries? This cannot be undone."
msgstr "آیتم‌های لاگ انتخاب‌شده حذف شوند؟ این عمل قابل بازگشت نیست."

msgid "Delete ALL log entries? This cannot be undone."
msgstr "تمام آیتم‌های لاگ حذف شوند؟ این عمل قابل بازگشت نیست."

