msgstr "ذخیرهٔ گیرنده"

msgid "Update Recipient"
msgstr "به‌روزرسانی گیرنده"

msgid "Add New Recipient"
msgstr "افزودن گیرندهٔ جدید"

msgid "Edit Recipient"
msgstr "ویرایش گیرنده"

msgid "Cancel"
msgstr "انصراف"

msgid "Recipient updated successfully."
msgstr "گیرنده با موفقیت به‌روزرسانی شد."

msgid "Recipient added successfully."
msgstr "گیرنده با موفقیت اضافه شد."

msgid "Invalid recipient ID."
msgstr "شناسهٔ گیرنده نامعتبر است."

msgid "Recipient deleted successfully."
msgstr "گیرنده با موفقیت حذف شد."

msgid "Connection verified successfully."
msgstr "اتصال با موفقیت تأیید شد."

#: includes/class-bale-installer.php
msgid "Bale Connector requires PHP %1$s+ (current: %2$s) and WordPress %3$s+ (current: %4$s)."
msgstr "افزونهٔ Bale Connector به PHP %1$s یا بالاتر (فعلی: %2$s) و وردپرس %3$s یا بالاتر (فعلی: %4$s) نیاز دارد."

msgid "Plugin Activation Error"
msgstr "خطای فعال‌سازی افزونه"

#: includes/class-bale-api-client.php
msgid "user_id is required and must be numeric."
msgstr "user_id الزامی است و باید عددی باشد."

msgid "Bale API returned an invalid (non-JSON) response for %1$s (HTTP %2$d)."
msgstr "Bale API برای %1$s پاسخ نامعتبر (غیر JSON) برگرداند (HTTP %2$d)."

msgid "Bale API call to %s succeeded but returned no result field."
msgstr "فراخوانی Bale API برای %s موفق بود اما فیلد result برنگرداند."

msgid "File not found: %s"
msgstr "فایل یافت نشد: %s"

msgid "File is not readable: %s"
msgstr "فایل خواندنی نیست: %s"

msgid "Unable to determine file size: %s"
msgstr "تعیین حجم فایل ممکن نشد: %s"

msgid "File size (%1$s bytes) exceeds the maximum allowed (%2$s bytes) for Bale API uploads: %3$s"
msgstr "حجم فایل (%1$s بایت) از سقف مجاز (%2$s بایت) برای آپلود در Bale API بیشتر است: %3$s"

msgid "Failed to read file contents: %s"
msgstr "خواندن محتوای فایل ناموفق بود: %s"

msgid "chat_id is required and cannot be empty."
msgstr "chat_id الزامی است و نمی‌تواند خالی باشد."

msgid "Invalid chat_id format: %s. Must be an integer or @username string."
msgstr "قالب chat_id نامعتبر است: %s. باید عدد صحیح یا رشتهٔ @username باشد."

msgid "%1$s length (%2$d) exceeds the maximum allowed (%3$d) for the Bale API."
msgstr "طول %1$s برابر %2$d از سقف مجاز %3$d برای Bale API بیشتر است."

msgid "Bale API call to %1$s failed (HTTP %2$d)."
msgstr "فراخوانی Bale API برای %1$s ناموفق بود (HTTP %2$d)."

